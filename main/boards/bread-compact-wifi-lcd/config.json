{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-wechat",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240_MIRROR=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y",
                "CONFIG_SEND_WAKE_WORD_DATA=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-emote",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X240_MIRROR=y",

                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                "CONFIG_EMOTE_MESSAGE_NOTO_FONT=y",                
                "CONFIG_MMAP_FILE_NAME_LENGTH=32",

                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y",
                "CONFIG_SEND_WAKE_WORD_DATA=y",
                "CONFIG_LANGUAGE_ZH_CN=y",              
                
                "CONFIG_USE_AFE_WAKE_WORD=y",
                "CONFIG_SR_WN_WN9L_NIHAOXIAOZHI_TTS3=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SR_MN_EN_MULTINET7_QUANT=y",

                "CONFIG_WIFI_RMT_11KV_SUPPORT=y",
                "CONFIG_WIFI_RMT_RRM_SUPPORT=y",
                "CONFIG_WIFI_RMT_WNM_SUPPORT=y",
                "CONFIG_WIFI_RMT_ENABLE_ROAMING_APP=y",
                "CONFIG_WIFI_RMT_11R_SUPPORT=y",
                "CONFIG_ESP_WIFI_FTM_ENABLE=y"
            ]
        }
    ]
}
